# ============================================================
# ProClass - Variáveis de ambiente
#
# Copie este arquivo e preencha com os dados do SEU projeto Firebase:
#     cp .env.example .env.local
#
# O .env.local é ignorado pelo Git - nunca versione suas credenciais.
# ============================================================

# --- Firebase Web SDK (obrigatórias) ---
# Onde encontrar: Firebase Console > Configurações do projeto > Seus apps > app Web
# Estas chaves são públicas por natureza: são embutidas no bundle do navegador.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (opcionais) ---
# Necessárias apenas para criar/excluir usuários no painel /admin (API Routes).
# Onde encontrar: Firebase Console > Configurações do projeto > Contas de serviço
#                 > Gerar nova chave privada (baixa um JSON com estes dois campos)
# A chave privada deve ficar entre aspas e com os \n literais, numa única linha.
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"
